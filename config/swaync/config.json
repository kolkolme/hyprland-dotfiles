{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-left": 10,
  "control-center-width": 420,
  "control-center-height": 620,
  "fit-to-screen": false,
  "notification-window-width": 400,
  "notification-icon-size": 42,
  "notification-body-image-height": 140,
  "notification-body-image-width": 260,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "relative-timestamps": true,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 220,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "Нет уведомлений",
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Уведомления",
      "clear-all-button": true,
      "button-text": "Очистить"
    },
    "dnd": {
      "text": "Не беспокоить"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c 'nmcli -t radio wifi | grep -qx enabled && echo true || echo false'"
        },
        {
          "label": "",
          "command": "sh -c '$HOME/.local/bin/nightmode next'"
        },
        {
          "label": "",
          "command": "sh -c '$HOME/.local/bin/wallpick'"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; $HOME/.local/bin/screenshot'"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; $HOME/.local/bin/lock'"
        }
      ]
    },
    "volume": {
      "label": "",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-button-label": "",
      "collapse-button-label": "",
      "empty-list-label": "Ничего не играет"
    },
    "backlight": {
      "label": "",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 5
    }
  }
}
