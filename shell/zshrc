# VPN: без аргументов — просто включить (без вопросов), off — выключить, status — состояние
vpn() {
    local profile="VPN connection 1"
    local active=0
    nmcli -t -f NAME connection show --active | grep -qxF "$profile" && active=1

    case "$1" in
        status|-s)
            if (( active )); then
                echo "VPN: подключён ($profile)"
            else
                echo "VPN: отключён"
            fi
            echo -n "Внешний IP: "
            curl -s --max-time 5 https://ifconfig.me 2>/dev/null || echo "(не удалось определить)"
            echo
            ;;
        off|down|-d)
            if (( active )); then
                echo "vpn: отключаю..."
                nmcli connection down "$profile" >/dev/null 2>&1 \
                    && echo "vpn: отключён" || echo "vpn: не удалось отключить"
            else
                echo "vpn: уже отключён"
            fi
            ;;
        toggle|-t)
            if (( active )); then vpn off; else vpn on; fi
            ;;
        *)
            if (( active )); then
                echo "vpn: уже подключён ($profile)"
                return 0
            fi
            echo "vpn: подключаю..."
            if nmcli connection up "$profile" >/dev/null 2>&1; then
                echo "vpn: подключён ($profile)"
            else
                echo "vpn: не удалось подключиться" >&2
                return 1
            fi
            ;;
    esac
}

# Wi-Fi: без аргументов — выбрать сеть, wifi <имя> — подключиться напрямую
wifi() {
    case "$1" in
        list|-l)
            nmcli -f IN-USE,SSID,SIGNAL,SECURITY device wifi list
            return
            ;;
        off) nmcli radio wifi off; return ;;
        on)  nmcli radio wifi on;  return ;;
        "")  ;;
        *)   nmcli --ask device wifi connect "$1"; return ;;
    esac

    echo "Сканирую сети..." >&2
    nmcli device wifi rescan >/dev/null 2>&1
    local ssids
    ssids=$(nmcli -t -f SSID,SIGNAL device wifi list 2>/dev/null \
            | awk -F: 'NF && $1 != "" && !seen[$1]++ {printf "%s  (%s%%)\n", $1, $2}')

    if [[ -z "$ssids" ]]; then
        echo "wifi: сети не найдены" >&2
        return 1
    fi

    local pick
    if command -v fzf >/dev/null 2>&1; then
        pick=$(printf '%s\n' "$ssids" | fzf --prompt='Wi-Fi > ' --height=40% --reverse)
    else
        printf '%s\n' "$ssids" | nl -w2 -s'. '
        local n
        read "n?Номер сети (Enter — отмена): "
        [[ -z "$n" ]] && return 0
        pick=$(printf '%s\n' "$ssids" | sed -n "${n}p")
    fi

    [[ -z "$pick" ]] && return 0
    local ssid="${pick%%  (*}"
    echo "Подключаюсь к: $ssid"
    nmcli --ask device wifi connect "$ssid"
}

# обновление системы одной командой
update() {
    sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y
    echo "=== готово ==="
}

# распаковать любой архив
extract() {
    if [[ -z "$1" ]]; then
        echo "использование: extract <архив>" >&2
        return 1
    fi
    if [[ ! -f "$1" ]]; then
        echo "extract: файл не найден: $1" >&2
        return 1
    fi
    case "$1" in
        *.tar.bz2|*.tbz2) tar xjf   "$1" ;;
        *.tar.gz|*.tgz)   tar xzf   "$1" ;;
        *.tar.xz|*.txz)   tar xJf   "$1" ;;
        *.tar.zst)        tar --zstd -xf "$1" ;;
        *.tar)            tar xf    "$1" ;;
        *.bz2)            bunzip2   "$1" ;;
        *.gz)             gunzip    "$1" ;;
        *.xz)             unxz      "$1" ;;
        *.zip)            unzip     "$1" ;;
        *.rar)            unrar x   "$1" ;;
        *.7z)             7z x      "$1" ;;
        *.Z)              uncompress "$1" ;;
        *) echo "extract: неизвестный формат: $1" >&2; return 1 ;;
    esac
}

# громкость: vol — показать, vol 50 — поставить 50%
vol() {
    if [[ -z "$1" ]]; then
        wpctl get-volume @DEFAULT_AUDIO_SINK@
    else
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "${1}%" && wpctl get-volume @DEFAULT_AUDIO_SINK@
    fi
}

# выключить/включить звук
mute() {
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@
}

