# launch Telegram Desktop detached from the terminal
telegram() {
    local bin="$HOME/.local/opt/Telegram/Telegram"
    if [[ ! -x "$bin" ]]; then
        print -u2 "telegram: not found at $bin"
        return 127
    fi
    ( setsid "$bin" "$@" >/dev/null 2>&1 & )
}
alias tg='telegram'

